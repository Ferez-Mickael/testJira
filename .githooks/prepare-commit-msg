#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# 1. Skip if it's a merge, amend, or if the template is already applied
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "commit" ]; then
    exit 0
fi
if grep -q "What is changing?" "$COMMIT_MSG_FILE"; then
    exit 0
fi

# 2. Extract Jira Key and Keyword from branch
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

JIRA_KEY=$(echo "$BRANCH_NAME" | grep -oE '[A-Z0-9]+-[0-9]+' | head -n 1)
KEYWORD=$(echo "$BRANCH_NAME" | grep -oE '(feat|fix|chore)' | head -n 1)

# Read the raw file (this captures what you typed in the VS Code box)
RAW_FILE=$(cat "$COMMIT_MSG_FILE")

# Extract the title (first line that isn't a Git comment and isn't empty)
USER_TITLE=$(echo "$RAW_FILE" | grep -v '^#' | grep '[^[:space:]]' | head -n 1)

if [ -z "$USER_TITLE" ]; then
    # SCENARIO A: Terminal commit (You haven't typed anything yet)
    echo "$JIRA_KEY-$KEYWORD: " > "$COMMIT_MSG_FILE"
    echo "" >> "$COMMIT_MSG_FILE"
    echo "What is changing?" >> "$COMMIT_MSG_FILE"
    echo "- " >> "$COMMIT_MSG_FILE"
    echo "$RAW_FILE" >> "$COMMIT_MSG_FILE"
else
    # SCENARIO B: VS Code commit (You typed a message in the box)
    
    # Force the first character of your title to lowercase
    FIRST_CHAR=$(echo "$USER_TITLE" | cut -c1 | tr '[:upper:]' '[:lower:]')
    REST_CHAR=$(echo "$USER_TITLE" | cut -c2-)
    LOWER_TITLE="${FIRST_CHAR}${REST_CHAR}"
    
    # Write the perfectly formatted title
    echo "$JIRA_KEY-$KEYWORD: $LOWER_TITLE" > "$COMMIT_MSG_FILE"
    echo "" >> "$COMMIT_MSG_FILE"
    echo "What is changing?" >> "$COMMIT_MSG_FILE"
    
    # Grab any extra description lines you typed in VS Code and make them bullets
    USER_DESC=$(echo "$RAW_FILE" | grep -v '^#' | grep '[^[:space:]]' | tail -n +2)
    
    if [ -n "$USER_DESC" ]; then
        echo "$USER_DESC" | while IFS= read -r line; do
            # Don't add a bullet if the user already typed one
            case "$line" in
                -*)  echo "$line" >> "$COMMIT_MSG_FILE" ;;
                *)   echo "- $line" >> "$COMMIT_MSG_FILE" ;;
            esac
        done
    else
        # If no description was typed, leave a blank bullet
        echo "- " >> "$COMMIT_MSG_FILE"
    fi
    
    # Append the original git comments at the bottom
    echo "$RAW_FILE" | grep '^#' >> "$COMMIT_MSG_FILE"
fi

exit 0
