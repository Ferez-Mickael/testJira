#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# 1. Skip if it's a merge, amend, or if the template is already applied
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "commit" ]; then
    exit 0
fi
if grep -q "What is changing?" "$COMMIT_MSG_FILE"; then
    exit 0
fi

# 2. Extract Jira Key and Keyword from branch
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

JIRA_KEY=$(echo "$BRANCH_NAME" | grep -oE '[A-Z0-9]+-[0-9]+' | head -n 1)
KEYWORD=$(echo "$BRANCH_NAME" | grep -oE '(feat|fix|chore)' | head -n 1)

# ====================================================================
# CASE A: Standard Git Commit (Opens your editor)
# ====================================================================
if [ -z "$COMMIT_SOURCE" ] || [ "$COMMIT_SOURCE" = "template" ]; then
    # Save the default Git comments ("# Please enter the commit message...")
    ORIGINAL_CONTENT=$(cat "$COMMIT_MSG_FILE")
    
    # Build the fresh template for you to type into! (Updated to Version 1.2 hyphen)
    echo "$JIRA_KEY-$KEYWORD: " > "$COMMIT_MSG_FILE"
    echo "" >> "$COMMIT_MSG_FILE"
    echo "What is changing?" >> "$COMMIT_MSG_FILE"
    echo "- " >> "$COMMIT_MSG_FILE"
    echo "# Please start each separate functionality or modification with a '- '" >> "$COMMIT_MSG_FILE"
    echo "" >> "$COMMIT_MSG_FILE"
    
    # Append the original git comments at the very bottom
    echo "$ORIGINAL_CONTENT" >> "$COMMIT_MSG_FILE"
    exit 0
fi

# ====================================================================
# CASE B: Inline Git Commit (You used: git commit -m "title" -m "desc")
# ====================================================================
if [ "$COMMIT_SOURCE" = "message" ]; then
    USER_MSG=$(cat "$COMMIT_MSG_FILE")
    GIT_TITLE=$(echo "$USER_MSG" | head -n 1)
    GIT_DESCRIPTION=$(echo "$USER_MSG" | tail -n +2)

    # Force the first character of the title to lowercase
    if [ -n "$GIT_TITLE" ]; then
        FIRST_CHAR=$(echo "$GIT_TITLE" | cut -c1 | tr '[:upper:]' '[:lower:]')
        REST_CHAR=$(echo "$GIT_TITLE" | cut -c2-)
        LOWER_TITLE="${FIRST_CHAR}${REST_CHAR}"
    else
        LOWER_TITLE="add change description"
    fi

    # Write formatted Title (Updated to Version 1.2 hyphen)
    echo "$JIRA_KEY-$KEYWORD: $LOWER_TITLE" > "$COMMIT_MSG_FILE"
    echo "" >> "$COMMIT_MSG_FILE"
    
    # Write formatted Description
    echo "What is changing?" >> "$COMMIT_MSG_FILE"
    if echo "$GIT_DESCRIPTION" | grep -q '[^[:space:]]'; then
        echo "$GIT_DESCRIPTION" | while IFS= read -r line; do
            if [ -z "$line" ]; then continue; fi
            case "$line" in
                -*)  echo "$line" >> "$COMMIT_MSG_FILE" ;;
                \#*) echo "$line" >> "$COMMIT_MSG_FILE" ;;
                *)   echo "- $line" >> "$COMMIT_MSG_FILE" ;;
            esac
        done
    else
        echo "- " >> "$COMMIT_MSG_FILE"
    fi
    exit 0
fi
