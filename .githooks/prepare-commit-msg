#!/bin/sh

COMMIT_MSG_FILE=$1
USER_MSG=$(cat "$COMMIT_MSG_FILE")

# 1. Skip if it's a merge commit or if template is already applied
if echo "$USER_MSG" | grep -q "What is changing?" || echo "$USER_MSG" | grep -q "^Merge branch"; then
    exit 0
fi

# 2. Extract Jira Key and Keyword from branch (e.g., PROJ-123/feat-addLoginPage)
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

JIRA_KEY=$(echo "$BRANCH_NAME" | grep -oE '[A-Z0-9]+-[0-9]+' | head -n 1)
KEYWORD=$(echo "$BRANCH_NAME" | grep -oE '(feat|fix|chore)' | head -n 1)

if [ -z "$JIRA_KEY" ]; then
    JIRA_KEY="PROJ-000"
fi

if [ -z "$KEYWORD" ]; then
    KEYWORD="feat"
fi

# 3. Process Title: Force description to start with a lowercase letter
GIT_TITLE=$(echo "$USER_MSG" | head -n 1)
GIT_DESCRIPTION=$(echo "$USER_MSG" | tail -n +2)

if [ -n "$GIT_TITLE" ]; then
    FIRST_CHAR=$(echo "$GIT_TITLE" | cut -c1 | tr '[:upper:]' '[:lower:]')
    REST_CHAR=$(echo "$GIT_TITLE" | cut -c2-)
    LOWER_TITLE="${FIRST_CHAR}${REST_CHAR}"
else
    LOWER_TITLE="add change description"
fi

# 4. Write Subject Line: PROJ-123/fix: add login timeout loop
echo "$JIRA_KEY/$KEYWORD: $LOWER_TITLE" > "$COMMIT_MSG_FILE"
echo "" >> "$COMMIT_MSG_FILE"

# 5. Build Description Template
echo "What is changing?" >> "$COMMIT_MSG_FILE"

# Check if description has content (ignoring empty spaces/newlines)
if echo "$GIT_DESCRIPTION" | grep -q '[^[:space:]]'; then
    echo "$GIT_DESCRIPTION" | while IFS= read -r line; do
        if [ -z "$line" ]; then continue; fi
        
        # We escape the hashtag (\#) so bash doesn't treat it as a comment!
        case "$line" in
            -*) 
                echo "$line" >> "$COMMIT_MSG_FILE" 
                ;;
            \#*) 
                echo "$line" >> "$COMMIT_MSG_FILE" 
                ;;
            *)     
                echo "- $line" >> "$COMMIT_MSG_FILE" 
                ;;
        esac
    done
else
    # Pre-populate the first '-' bullet point for response
    echo "- " >> "$COMMIT_MSG_FILE"
    # Instructions to developer (Git ignores lines starting with '#')
    echo "# Please start each separate functionality or modification with a '- '" >> "$COMMIT_MSG_FILE"
fi
